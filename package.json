{
	"name": "obsidian-auto-anki",
	"version": "0.3.0",
	"description": "This is a plugin for Obsidian (https://obsidian.md). The plugin allows use of GPT to automate card creation for Spaced Repetition in Anki",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"release": "git push origin --tags",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.5",
		"esbuild": "0.28.2",
		"eslint": "10.12.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"obsidian": "1.14.4",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1"
	},
	"dependencies": {
		"openai": "6.39.1",
		"winston": "^3.11.0",
		"winston-transport": "^4.6.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cadrianxyz/obsidian-auto-anki.git"
	}
}
